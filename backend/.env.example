# ============================================
# Barbell Fitness — Backend Environment Config
# ============================================
# 1. Copy this file:   cp .env.example .env
# 2. Paste your MongoDB connection string below.
# 3. Change JWT_SECRET to a long random string.

# MongoDB connection string (Atlas or local)
# Example (Atlas):  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/barbell?retryWrites=true&w=majority
# Example (Local):  mongodb://127.0.0.1:27017/barbell
MONGO_URI=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS — frontend origin (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173
